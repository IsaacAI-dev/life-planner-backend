// Life Planner — Prisma schema
// Base spec + Addendum 2 (moderation/analytics, task privacy, board sharing,
// flexible tasks, nutrition board, budget tracker).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AdminRole {
  SUPPORT
  SUPERADMIN
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

enum ReminderChannel {
  EMAIL
  PUSH
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

enum ConversationChannel {
  GENERAL
  COACHING
  SUPPORT
}

enum ConversationStatus {
  OPEN
  CLAIMED
  CLOSED
}

enum MessageSenderType {
  USER
  ADMIN
  SYSTEM
}

enum ActivityChangeType {
  CREATED
  UPDATED
  TOGGLED
  DELETED
  DELETED_BY_ADMIN
}

// --- Addendum 2 ---

enum BoardPermissionLevel {
  PUBLIC_ONLY // viewer sees only isPrivate = false activities
  FULL // viewer sees all activities, including private ones
}

enum BoardShareStatus {
  ACTIVE
  REVOKED
}

enum FoodCategory {
  PROTEIN
  CARBOHYDRATE
  VEGETABLE
  FRUIT
  DAIRY
  FAT_OIL
  BEVERAGE
  SNACK
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealPlanStatus {
  DRAFT // admin is still building it; hidden from the user
  PUBLISHED // visible to the user
}

enum BudgetCategory {
  MANDATORY
  SECONDARY
  OPTIONAL
}

enum AnalyticsEventType {
  PAGE_VIEW
  CUSTOM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  timezone     String  @default("UTC")
  country      String? // ISO 3166-1 alpha-2, used to pre-filter the food catalog
  avatarUrl    String?
  icalToken    String? @unique

  // Addendum 2 — moderation
  status                 UserStatus @default(ACTIVE)
  statusReason           String?
  statusChangedAt        DateTime?
  statusChangedByAdminId String?
  statusChangedByAdmin   Admin?     @relation("UserStatusChanges", fields: [statusChangedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categories          Category[]
  activities          Activity[]
  activityBatches     ActivityBatch[]
  recurringTemplates  RecurringTemplate[]
  goals               Goal[]
  tags                Tag[]
  reminders           Reminder[]
  dayNotes            DayNote[]
  settings            UserSettings?
  conversations       Conversation[]
  messages            Message[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  // Addendum 2
  boardSharesOwned  BoardShare[]        @relation("BoardSharesOwned")
  boardSharesViewed BoardShare[]        @relation("BoardSharesViewed")
  foodInventory     UserFoodInventory[]
  mealPlans         MealPlan[]
  budgetMonths      BudgetMonth[]
  analyticsEvents   AnalyticsEvent[]

  @@index([status])
  @@index([createdAt])
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(SUPPORT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  refreshTokens         AdminRefreshToken[]
  assignedConversations Conversation[]
  messages              Message[]
  activityHistory       ActivityHistory[]

  // Addendum 2
  moderatedUsers    User[]     @relation("UserStatusChanges")
  createdMealPlans  MealPlan[]
}

model RefreshToken {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash          String    @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  replacedByTokenHash String?
  createdAt          DateTime  @default(now())

  @@index([userId])
}

model AdminRefreshToken {
  id        String    @id @default(cuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Planner core
// ---------------------------------------------------------------------------

model Category {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String    @default("#6366F1")
  icon      String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activities         Activity[]
  recurringTemplates RecurringTemplate[]

  @@unique([userId, name])
  @@index([userId])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#64748B")
  createdAt DateTime @default(now())

  activities Activity[] @relation("ActivityTags")

  @@unique([userId, name])
  @@index([userId])
}

model ActivityBatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())

  activities Activity[]

  @@index([userId])
}

model Activity {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // Addendum 2: `date` is now optional — null <=> this is a flexible task.
  date        DateTime? @db.Date
  startTime   String? // "HH:mm"
  endTime     String? // "HH:mm"
  isDone      Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)

  // Addendum 2 — privacy
  isPrivate Boolean @default(false)

  // Addendum 2 — flexible / non-date-specific tasks
  windowStart    DateTime? @db.Date
  windowEnd      DateTime? @db.Date
  targetCount    Int       @default(1)
  completedCount Int       @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  batchId String?
  batch   ActivityBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  recurringTemplateId String?
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  tags      Tag[]             @relation("ActivityTags")
  reminders Reminder[]
  history   ActivityHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, date])
  @@index([userId, isDone])
  @@index([userId, windowStart, windowEnd])
  @@index([batchId])
  @@index([recurringTemplateId])
}

model ActivityHistory {
  id         String             @id @default(cuid())
  activityId String
  activity   Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  changeType ActivityChangeType
  snapshot   Json?
  adminId    String?
  admin      Admin?             @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())

  @@index([activityId, createdAt])
}

model RecurringTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  rrule       String
  startTime   String?
  endTime     String?
  isPrivate   Boolean  @default(false)
  active      Boolean  @default(true)
  horizonEnd  DateTime? @db.Date
  lastMaterializedAt DateTime?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?  @db.Date
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  milestones Milestone[]
  activities Activity[]

  @@index([userId, status])
}

model Milestone {
  id        String    @id @default(cuid())
  goalId    String
  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime? @db.Date
  isDone    Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([goalId])
}

model Reminder {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String?
  activity   Activity?       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  remindAt   DateTime
  channel    ReminderChannel @default(EMAIL)
  status     ReminderStatus  @default(PENDING)
  message    String?
  sentAt     DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status, remindAt])
  @@index([userId])
}

model DayNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  content   String
  mood      Int? // 1..5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model UserSettings {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                    String   @default("system")
  weekStartsOn             Int      @default(1)
  defaultCalendarView      String   @default("week")
  excludeWeekendsByDefault Boolean  @default(false)
  timezone                 String   @default("UTC")
  defaultCategoryId        String?
  notifications            Json     @default("{\"email\":true,\"push\":false,\"dailyReminderTime\":\"08:00\"}")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

model Conversation {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel         ConversationChannel @default(GENERAL)
  status          ConversationStatus  @default(OPEN)
  title           String?
  assignedAdminId String?
  assignedAdmin   Admin?              @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  lastMessageAt   DateTime?
  closedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  messages Message[]

  @@index([userId, status])
  @@index([status, lastMessageAt])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     MessageSenderType
  senderUserId   String?
  senderUser     User?             @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderAdminId  String?
  senderAdmin    Admin?            @relation(fields: [senderAdminId], references: [id], onDelete: SetNull)
  content        String
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Addendum 2 — Board sharing
// ---------------------------------------------------------------------------

model BoardShare {
  id         String               @id @default(cuid())
  ownerId    String // whose board is visible
  owner      User                 @relation("BoardSharesOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  viewerId   String // who is granted access
  viewer     User                 @relation("BoardSharesViewed", fields: [viewerId], references: [id], onDelete: Cascade)
  permission BoardPermissionLevel @default(PUBLIC_ONLY)
  status     BoardShareStatus     @default(ACTIVE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([ownerId, viewerId])
  @@index([viewerId, status])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Addendum 2 — Nutrition board
// ---------------------------------------------------------------------------

model FoodCatalogItem {
  id                 String       @id @default(cuid())
  country            String // ISO 3166-1 alpha-2, e.g. "NG", "US"
  name               String
  category           FoodCategory
  caloriesPerServing Int
  servingSize        String?
  proteinG           Float?
  carbsG             Float?
  fatG               Float?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  inventories   UserFoodInventory[]
  mealPlanItems MealPlanItem[]

  @@unique([country, name])
  @@index([country, category])
}

model UserFoodInventory {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItemId String
  foodItem   FoodCatalogItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([userId, foodItemId])
  @@index([userId])
}

model MealPlan {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByAdminId String
  createdByAdmin   Admin          @relation(fields: [createdByAdminId], references: [id], onDelete: Cascade)
  date             DateTime       @db.Date
  status           MealPlanStatus @default(DRAFT)
  targetCalories   Int?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items MealPlanItem[]

  @@unique([userId, date])
  @@index([userId, date])
}

model MealPlanItem {
  id         String           @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan         @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealType   MealType
  foodItemId String?
  foodItem   FoodCatalogItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  freeText   String?
  servings   Float            @default(1)
  order      Int              @default(0)

  @@index([mealPlanId])
}

// ---------------------------------------------------------------------------
// Addendum 2 — Budget tracker
// ---------------------------------------------------------------------------

model BudgetMonth {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year            Int
  month           Int // 1..12
  estimatedIncome Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  expenses BudgetExpense[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model BudgetExpense {
  id            String         @id @default(cuid())
  budgetMonthId String
  budgetMonth   BudgetMonth    @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  title         String
  amount        Decimal        @db.Decimal(12, 2)
  category      BudgetCategory
  date          DateTime?      @db.Date
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([budgetMonthId, category])
}

// ---------------------------------------------------------------------------
// Addendum 2 — Site analytics
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType @default(PAGE_VIEW)
  path      String?
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  referrer  String?
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([path])
  @@index([userId])
  @@index([sessionId])
}
