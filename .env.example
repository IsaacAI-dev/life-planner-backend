# ---- shared ----
NODE_ENV=development
DATABASE_URL=postgresql://lifeplanner:lifeplanner@localhost:5432/lifeplanner?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug

# ---- user-api ----
USER_API_PORT=4000
JWT_ACCESS_SECRET=dev-user-access-secret-change-me
JWT_REFRESH_SECRET=dev-user-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000
RECURRING_HORIZON_DAYS=60
ENABLE_JOBS=true

# ---- admin-api ----
ADMIN_API_PORT=4001
ADMIN_JWT_SECRET=dev-admin-access-secret-change-me
ADMIN_JWT_REFRESH_SECRET=dev-admin-refresh-secret-change-me
ADMIN_CORS_ORIGINS=http://localhost:3001

# ---- mail (console transport by default) ----
MAIL_TRANSPORT=console
MAIL_FROM="Life Planner <no-reply@lifeplanner.local>"

# ---- seed ----
SEED_ADMIN_EMAIL=admin@lifeplanner.local
SEED_ADMIN_PASSWORD=admin12345
SEED_DEMO_EMAIL=demo@lifeplanner.local
SEED_DEMO_PASSWORD=demo12345

# ===========================================================================
# Addendum 3
# ===========================================================================

# ---- Free-tier quotas (change without a deploy) ----
FREE_MAX_ACTIVITIES_PER_WEEK=5
FREE_MAX_GOALS=3

# ---- Uploads ----
VOICE_NOTE_MAX_SECONDS=300
VOICE_NOTE_MAX_BYTES=10485760
AVATAR_MAX_BYTES=5242880

# ---- Storage ----
# 'local' writes to LOCAL_STORAGE_DIR and serves from /media, so uploads work
# in development with no Cloudflare account. Switch to 'r2' in production.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lifeplanner
R2_PUBLIC_BASE_URL=

# ---- Payments ----
# Web: Paddle outside Africa, Paystack within. Mobile: the store, worldwide.
BILLING_DEFAULT_CURRENCY=NGN

PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox

PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/plan/callback

APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=app.lifeplanner

GOOGLE_PACKAGE_NAME=app.lifeplanner
# Paste the service-account JSON on one line, or leave blank in development.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Set false in development to accept store receipts without contacting
# Apple/Google. MUST be true in production.
VERIFY_STORE_RECEIPTS=false

# ---- Store server notifications ----
# Apple: App Store Connect → App Information → Server Notifications V2 URL
#   https://your-api/webhooks/store/apple
# Google: Play Console → Monetisation setup → Pub/Sub topic, pushing to
#   https://your-api/webhooks/store/google?token=<GOOGLE_PUBSUB_TOKEN>
GOOGLE_PUBSUB_TOKEN=
APPLE_ROOT_CA_G3=
