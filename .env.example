# ───────────── Core ─────────────
DATABASE_URL=postgresql://lifeplanner:lifeplanner@localhost:5432/lifeplanner?schema=public
REDIS_URL=redis://localhost:6379

USER_API_PORT=4000
ADMIN_API_PORT=4001
NODE_ENV=development

# ───────────── CORS allowlists (per service) ─────────────
CORS_ORIGIN_USER=http://localhost:3000
CORS_ORIGIN_ADMIN=http://localhost:3001

# ───────────── Auth ─────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ADMIN_JWT_SECRET=change-me-admin-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ───────────── Notifications (reminders) ─────────────
MAIL_PROVIDER=smtp            # smtp | resend | console
MAIL_FROM=Life Planner <no-reply@lifeplanner.local>
SMTP_URL=smtp://localhost:1025
# RESEND_API_KEY=

# Push (optional; FCM / web-push)
# FCM_SERVER_KEY=
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=

# ───────────── Jobs ─────────────
RECURRING_HORIZON_DAYS=60
